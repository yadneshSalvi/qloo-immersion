# Shared local web/database settings. Keep .env.local private.
# Replace both password placeholders with the same local development password.
POSTGRES_PASSWORD=replace_me_with_a_local_password
DATABASE_URL=postgresql://immersion:replace_me_with_a_local_password@127.0.0.1:55432/immersion
APP_ORIGIN=http://127.0.0.1:3103

# Editorial browsing and fixed practice work with both capabilities disabled.
# Set a flag to 1 only when a separately configured private worker can serve it.
LIVE_QLOO_ENABLED=0
LIVE_COACHING_ENABLED=0

# Deployed database TLS: mount the trusted database CA and choose the verified mode.
# DATABASE_SSL_CA_FILE=
# DATABASE_SSL_MODE=verify-full
# DATABASE_POOL_MAX=8

# Optional local private dispatch; the local worker can also poll PostgreSQL.
# WORKER_URL=http://127.0.0.1:3104
# Inject a separate random token of at least 32 characters for local dispatch.
# WORKER_DISPATCH_TOKEN=

# PRIVATE WORKER ENVIRONMENT ONLY: inject separately, not into the shared web file.
# Never commit actual provider keys or reviewed canonical bridge identities.
# QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# IMMERSION_CULTURAL_BRIDGES_FILE=
# Alternatively inject the reviewed strict array through IMMERSION_CULTURAL_BRIDGES_JSON.
# QLOO_DAILY_CALL_LIMIT=100
# QLOO_GUEST_DAILY_CALL_LIMIT=15
# MODEL_DAILY_CALL_LIMIT=120
# MODEL_GUEST_DAILY_CALL_LIMIT=12

# pnpm qloo:probe inspects the installed harness without credentials or live requests.
